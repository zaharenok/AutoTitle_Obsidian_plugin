{
  "enabled": true,
  "name": "Auto Git Commit",
  "description": "Automatically creates proper git commits when files in the AutoTitleObsidian project are changed",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "*.ts",
      "*.md",
      "*.css"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Files have been modified in the AutoTitleObsidian project. Please analyze the changes and create an appropriate git commit with a meaningful commit message. Stage the changed files, write a descriptive commit message that explains what was modified, and push the changes to the GitHub repository at https://github.com/zaharenok/AutoTitleObsidian\nBut in README.md say GPT latest models"
  }
}